# Local mock development works without external credentials.
APP_ENV=development
STORAGE_BACKEND=sqlite
SQLITE_PATH=.local/black-fire.sqlite3
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Required for hosted mode (APP_ENV=production, STORAGE_BACKEND=supabase).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Inventory for day two. These are NOT used by the day-one mock worker.
GEMINI_API_KEY=
GEMINI_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
